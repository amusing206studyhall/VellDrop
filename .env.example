NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_PRO_PRICE_ID=
PADDLE_PLUS_PRICE_ID=
NEXT_PUBLIC_SUPPORT_EMAIL=
CRON_SECRET=
